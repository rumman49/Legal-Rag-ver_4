# Copy this file to backend/.env and fill in your own values.
# Never commit the filled-in .env file.

GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
DEFAULT_LLM_PROVIDER=
LANGCHAIN_TRACING_V2=
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
CHROMA_PERSIST_DIRECTORY=
CHROMA_COLLECTION_NAME=
EMBEDDING_MODEL_NAME=
TAVILY_API_KEY=

# Optional: comma-separated providers to try if the main one fails (empty = none)
LLM_FALLBACK_PROVIDERS=
# Optional: comma-separated browser origins allowed to call the API (empty = same origin only)
CORS_ORIGINS=

# Optional tuning (defaults shown)
# RETRIEVAL_MIN_SCORE=0.05
# GROQ_MAX_RETRIES=4
# GROQ_TIMEOUT_SECONDS=60
